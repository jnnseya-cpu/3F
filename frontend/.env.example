# ============================================================
# Le Congo D'Abord — Environment Variables Example
# Copy this file to .env.local and fill in your values
# ============================================================

# Database
DATABASE_URL=postgresql://lcd_user:lcd_password@localhost:5432/lcd_ai_os
POSTGRES_DB=lcd_ai_os
POSTGRES_USER=lcd_user
POSTGRES_PASSWORD=lcd_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_SECRET_KEY=your-backend-secret-key

# App Config
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Le Congo D'Abord
NEXT_PUBLIC_APP_VERSION=1.0.0

# Optional: Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password

# ============================================================
# Encryption (End-to-End layer)
# ============================================================
# 32+ character secret for field-level AES-256-GCM encryption at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
# JWT signing secret for API tokens
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRE_MINUTES=60
# Force HTTPS redirect in production
ENFORCE_HTTPS=true

# ============================================================
# Multi-provider AI (fallback order: Claude -> OpenAI -> Gemini)
# ============================================================
# ANTHROPIC_API_KEY is above. Optional fallbacks:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# Firebase (member records)
# Project settings -> General -> Web API key + Project ID
# ============================================================
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# ============================================================
# BitriPay (contributions -> your bank)
# From your BitriPay merchant dashboard
# ============================================================
BITRIPAY_API_KEY=
BITRIPAY_API_URL=
BITRIPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ============================================================
# ACU — AI Compute Units (metering of ALL AI actions)
# Ledger lives in Firestore collection acu_accounts/{memberId}.
# Payments credit ACUs automatically: monthly=5, quarterly=18, annual=80.
# Top up the autopilot system account: acu_accounts/system-autopilot
# ============================================================

# ============================================================
# SENTINEL — anti-hacking / human-only gate
# ============================================================
HUMAN_GATE_SECRET=change-me-generate-with-openssl-rand-base64-32
SENTINEL_ADMIN_KEY=change-me-admin-key-for-security-dashboard
