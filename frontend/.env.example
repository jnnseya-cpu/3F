# ============================================================
# Le Congo D'Abord — environment variables (single source of truth)
# Local dev: copy to `.env.local` and fill values (NEVER commit real values).
# Production: set these as secrets in Firebase App Hosting (see apphosting.yaml).
# ============================================================

# --- Public (inlined into the client bundle; no secrets here) ---
NEXT_PUBLIC_APP_NAME="Le Congo D'Abord"
NEXT_PUBLIC_SITE_URL=https://congodabord.cd
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=

# --- Firebase Admin (server writer; unlocks persistence, auth, ledger) ---
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
# Paste the PEM; \n escapes are handled at runtime:
FIREBASE_PRIVATE_KEY=
# Or a single JSON blob instead of the three above:
# FIREBASE_SERVICE_ACCOUNT=

# --- AI providers (fallback: Claude -> OpenAI -> Gemini) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Payments (mobile-money gateway) ---
BITRIPAY_API_KEY=
BITRIPAY_API_URL=
BITRIPAY_WEBHOOK_SECRET=

# --- Security / sessions ---
MEMBER_TOKEN_SECRET=   # openssl rand -base64 48  — turns on member-token auth
HUMAN_GATE_SECRET=     # openssl rand -base64 48
SENTINEL_ADMIN_KEY=    # openssl rand -base64 48
CRON_SECRET=           # openssl rand -base64 48  — protects cron endpoints
JWT_SECRET=            # openssl rand -base64 48
ENCRYPTION_KEY=        # openssl rand -base64 32  — field-level AES-256-GCM

# --- Email (weekly newsletter, via Resend) ---
RESEND_API_KEY=
NEWSLETTER_FROM="Le Congo D'Abord <news@congodabord.cd>"
NEWSLETTER_SECRET=     # HMAC for one-click unsubscribe
