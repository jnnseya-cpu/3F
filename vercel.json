{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "rootDirectory": "frontend",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_APP_NAME": "Le Congo D'Abord"
  },
  "crons": [
    {
      "path": "/api/seo/autopilot",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/newsletter/send",
      "schedule": "0 8 * * 1"
    }
  ]
}
